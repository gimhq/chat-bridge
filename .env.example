# Environment overrides (take precedence over chat-bridge.yaml). Section_key → CHATBRIDGE_<SECTION>_<KEY>.
CHATBRIDGE_SERVER_TOKEN=change-me-to-a-long-random-string
# CHATBRIDGE_CONFIG=/etc/chat-bridge/chat-bridge.yaml
# CHATBRIDGE_SERVER_ADDR=:8080
# CHATBRIDGE_SERVER_TOKEN_FILE=/run/secrets/chat-bridge-token
# CHATBRIDGE_SERVER_ADAPTER_TOKEN=another-long-random-string
# CHATBRIDGE_SERVER_PUBLIC_URL=https://bridge.example.org
# CHATBRIDGE_STORAGE_DATA_DIR=./data
# CHATBRIDGE_MEDIA_AUTO_DOWNLOAD=image,voice,sticker
# CHATBRIDGE_MEDIA_AUTO_DOWNLOAD_MAX_MB=16
# CHATBRIDGE_MEDIA_MAX_UPLOAD_MB=64
# CHATBRIDGE_EVENTS_RETENTION_DAYS=7
# CHATBRIDGE_LOG_LEVEL=info
# CHATBRIDGE_PERSONS_AUTO_LINK_BY_PHONE=true
# CHATBRIDGE_ADAPTERS_TELEGRAM_API_ID=12345
# CHATBRIDGE_ADAPTERS_TELEGRAM_API_HASH=your-api-hash
# CHATBRIDGE_ADAPTERS_TELEGRAM_BRIDGEV2=false
